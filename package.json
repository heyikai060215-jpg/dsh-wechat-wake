{
  "name": "dsh-wechat-wake",
  "version": "0.1.0",
  "description": "微信定时唤醒（dsh-wechat-wake）：给微信里的 agent 一组自己的定时工具。到点它自己醒过来说话，说的话直接落进当前微信聊天；授权仍由 WeChatAgent 的「能力与权限」按聊天勾选。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "wechatagent",
    "reminder",
    "schedule",
    "agent"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyikai060215-jpg/dsh-wechat-wake.git"
  },
  "homepage": "https://github.com/heyikai060215-jpg/dsh-wechat-wake#readme",
  "bugs": {
    "url": "https://github.com/heyikai060215-jpg/dsh-wechat-wake/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
